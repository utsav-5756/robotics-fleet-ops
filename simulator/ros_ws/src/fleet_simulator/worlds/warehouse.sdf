<?xml version="1.0"?>
<sdf version="1.9">
  <world name="warehouse">
    <physics name="warehouse_physics" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.80 0.86 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="warehouse_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -0.8</direction>
    </light>

    <model name="warehouse_floor">
      <static>true</static>
      <link name="floor">
        <collision name="floor_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>14 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>14 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.75 0.74 1</ambient>
            <diffuse>0.72 0.75 0.74 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rack_north">
      <static>true</static>
      <pose>0 3.65 0.8 0 0 0</pose>
      <link name="rack">
        <visual name="rack_visual">
          <geometry><box><size>9 0.65 1.6</size></box></geometry>
          <material>
            <ambient>0.35 0.40 0.47 1</ambient>
            <diffuse>0.35 0.40 0.47 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rack_south">
      <static>true</static>
      <pose>0 -3.65 0.8 0 0 0</pose>
      <link name="rack">
        <visual name="rack_visual">
          <geometry><box><size>9 0.65 1.6</size></box></geometry>
          <material>
            <ambient>0.35 0.40 0.47 1</ambient>
            <diffuse>0.35 0.40 0.47 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="robot_01">
      <static>true</static>
      <pose>-5 -2 0.12 0 0 0</pose>
      <link name="base">
        <visual name="body">
          <geometry><box><size>0.65 0.45 0.20</size></box></geometry>
          <material>
            <ambient>0.10 0.35 0.75 1</ambient>
            <diffuse>0.10 0.35 0.75 1</diffuse>
          </material>
        </visual>
        <visual name="front_marker">
          <pose>0.23 0 0.11 0 0 0</pose>
          <geometry><box><size>0.12 0.18 0.04</size></box></geometry>
          <material>
            <ambient>1 0.75 0.05 1</ambient>
            <diffuse>1 0.75 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="robot_02">
      <static>true</static>
      <pose>-2 0 0.12 0 0 0</pose>
      <link name="base">
        <visual name="body">
          <geometry><box><size>0.65 0.45 0.20</size></box></geometry>
          <material>
            <ambient>0.08 0.55 0.35 1</ambient>
            <diffuse>0.08 0.55 0.35 1</diffuse>
          </material>
        </visual>
        <visual name="front_marker">
          <pose>0.23 0 0.11 0 0 0</pose>
          <geometry><box><size>0.12 0.18 0.04</size></box></geometry>
          <material>
            <ambient>1 0.75 0.05 1</ambient>
            <diffuse>1 0.75 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="robot_03">
      <static>true</static>
      <pose>1 2 0.12 0 0 0</pose>
      <link name="base">
        <visual name="body">
          <geometry><box><size>0.65 0.45 0.20</size></box></geometry>
          <material>
            <ambient>0.72 0.24 0.16 1</ambient>
            <diffuse>0.72 0.24 0.16 1</diffuse>
          </material>
        </visual>
        <visual name="front_marker">
          <pose>0.23 0 0.11 0 0 0</pose>
          <geometry><box><size>0.12 0.18 0.04</size></box></geometry>
          <material>
            <ambient>1 0.75 0.05 1</ambient>
            <diffuse>1 0.75 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
